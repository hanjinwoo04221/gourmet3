[balance]
	#Global multiplier applied to all Toriko skill damage.
	# Default: 1.0
	# Range: 0.0 ~ 64.0
	damageMultiplier = 1.0
	#Global multiplier applied to all skill cooldowns. 0.5 = twice as fast.
	# Default: 1.0
	# Range: 0.0 ~ 16.0
	cooldownMultiplier = 1.0
	#Global multiplier applied to the Appetite cost of every skill.
	# Default: 1.0
	# Range: 0.0 ~ 16.0
	appetiteCostMultiplier = 1.0
	#Maximum Appetite (the skill resource). Restored by eating food.
	# Default: 100
	# Range: 10 ~ 10000
	maxAppetite = 100
	#How many ticks between passive Appetite regeneration ticks.
	# Default: 20
	# Range: 1 ~ 1200
	appetiteRegenInterval = 20
	#How much Appetite is restored per regeneration tick.
	# Default: 1
	# Range: 0 ~ 1000
	appetiteRegenAmount = 1
	#Appetite restored per point of food nutrition when eating.
	# Default: 4.0
	# Range: 0.0 ~ 200.0
	appetitePerNutrition = 4.0
	#When Appetite hits zero, inflict Weakness/Slowness (Toriko's 'starving' state).
	starvationPenalty = true

[world]
	#Let cutting skills (Knife / Flying Knife / Leg Knife) shear leaves and plants.
	cutVegetation = true

[gameplay]
	#Require an empty main hand for the bare-handed skills (everything but Food Immersion).
	skillsNeedEmptyHand = false
	#Whether Toriko skills can damage other players.
	affectPlayers = true
